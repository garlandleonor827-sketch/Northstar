{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrategicProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "proposalId",
    "baseVersions",
    "summary",
    "evidenceIds",
    "benefits",
    "risks",
    "changes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "proposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "baseVersions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "targetId",
          "before",
          "after"
        ],
        "properties": {
          "type": {
            "enum": [
              "revise_goal",
              "replace_primary_focus",
              "change_weekly_outcome"
            ]
          },
          "targetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        }
      }
    }
  }
}
