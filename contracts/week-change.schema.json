{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateWeekChange",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "baseVersion",
    "planId",
    "reason",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "baseVersion": {
      "type": "integer",
      "minimum": 0
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "taskId",
          "date",
          "rank"
        ],
        "properties": {
          "type": {
            "enum": [
              "schedule_task",
              "unschedule_task"
            ]
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "rank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        }
      }
    }
  }
}
